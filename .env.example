# ── /api/ask (the "Ask my AI" widget) ────────────────────────────
# Required. Without it the endpoint returns 503 and the widget says it's offline.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-mini (~$0.0005 per question).
ASK_MODEL=gpt-4o-mini

# Optional spend guards. Defaults shown; all enforced via Vercel KV.
ASK_VISITOR_DAILY_CAP=10     # questions per IP per day
ASK_DAILY_CAP=60             # questions site-wide per day
ASK_MONTHLY_CAP=1800         # questions site-wide per calendar month

# ── /api/comments (blog comments) ────────────────────────────────
# Required only for DELETE. Unset means every delete is rejected.
ADMIN_TOKEN=

# ── Vercel KV ────────────────────────────────────────────────────
# Both endpoints use @vercel/kv. Link a KV store to the project and Vercel
# injects KV_REST_API_URL / KV_REST_API_TOKEN automatically — pull them with
# `vercel env pull` for local work. If KV is unreachable, /api/ask keeps
# answering but WITHOUT rate limits, and comments stop working.

# ── qa-test.mjs ──────────────────────────────────────────────────
# Base URL the Playwright suite runs against. Defaults to production.
QA_BASE=http://localhost:3000
